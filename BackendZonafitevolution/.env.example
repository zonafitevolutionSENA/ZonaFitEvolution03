DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zonafitevolution

PORT=3000
# Al menos 32 caracteres aleatorios (el servidor no arranca con menos)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
BIOMETRIA_SALT=

# Zona horaria del servidor (en la nube es obligatoria)
TZ=America/Bogota

# Orígenes del frontend autorizados, separados por comas (en la nube: la URL de Vercel)
ORIGEN_FRONTEND=http://localhost:5173,http://127.0.0.1:5173

# Lector de huellas: as608 (USB en este equipo) o remoto (agente en otro equipo, para la nube)
TIPO_LECTOR=as608
# Puerto del lector AS608 (solo con as608): el COM que muestra el Administrador de dispositivos
PUERTO_LECTOR=COM3
LECTOR_BAUDIOS=57600
# Token compartido con el agente del lector (solo con remoto)
AGENTE_TOKEN=

# Pantalla de ingreso: con token en la nube; vacío = solo se acepta en el mismo equipo
PANTALLA_TOKEN=
# Origen adicional autorizado para la pantalla de ingreso local (opcional)
ORIGEN_PANTALLA_ACCESO=
