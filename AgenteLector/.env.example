# En la nube: wss://<tu-backend>.up.railway.app/agente   En local: ws://localhost:3000/agente
API_WS_URL=ws://localhost:3000/agente
# El mismo valor que AGENTE_TOKEN en el backend
AGENTE_TOKEN=
# Puerto del CP2102: auto = el agente lo busca solo (recomendado). También puede ser fijo: COM3, COM4...
PUERTO_LECTOR=auto
LECTOR_BAUDIOS=57600
# El MISMO valor de BIOMETRIA_SALT con el que se registraron las huellas del sensor
BIOMETRIA_SALT=
# Pantalla de ingreso que se abre sola en recepción (opcional; este es el valor por defecto)
FRONTEND_URL=https://zona-fit-evolution03.vercel.app
# Si se llena con el mismo PANTALLA_TOKEN de Railway, la pantalla se abre ya autorizada
PANTALLA_TOKEN=
